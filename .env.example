# Copy to .env.local for local dev. In Vercel, add these under
# Project → Settings → Environment Variables.

# Cal.com event to open from every "Book a call" button: "<username>/<event-slug>"
NEXT_PUBLIC_CAL_LINK=shashank-vaish-snw03h/15min

# Secret you type into Cal.com → Settings → Developer → Webhooks when creating
# the webhook. Used to verify the X-Cal-Signature-256 header.
CAL_WEBHOOK_SECRET=

# Optional: Slack or Discord "incoming webhook" URL. Each booking event is
# forwarded here as a short message.
BOOKING_NOTIFY_WEBHOOK_URL=

# Optional: Formspree/Getform endpoint for the contact form (mailto fallback if unset).
NEXT_PUBLIC_FORM_ENDPOINT=
